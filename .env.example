# ---------------------------------------------------------------------------
# CartPilot agent API configuration. Copy to `.env` for local development and
# set the same variables as secrets on Hugging Face Spaces / Render.
# NEVER commit a real .env file or API key.
# ---------------------------------------------------------------------------

# Postgres for short-term memory (LangGraph checkpoints), long-term memory, orders
# and products. Use a free Neon or Supabase database in production; for Supabase
# use the "Session pooler" connection string. Local: `docker compose up -d db`.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/cartpilot

# LLM. Production MUST use anthropic + claude-haiku-5-5 (hackathon rule).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_group_claude_api_key_here
CLAUDE_MODEL=claude-haiku-5-5

# Optional free provider for local development only (comma-separated keys).
# GROQ_API_KEYS=gsk_xxx,gsk_yyy
# GROQ_MODEL=openai/gpt-oss-120b

# Website auth. Set strong values in production.
ADMIN_PASSWORD=change-me
SECRET_KEY=generate-a-long-random-string

# Comma-separated list of allowed website origins ("*" allows all).
CORS_ORIGINS=*

# Seed two demo customers (ali / sara, password demo1234) and a few orders.
SEED_DEMO_DATA=true

# Tuning (defaults shown)
# MAX_OUTPUT_TOKENS=700
# HISTORY_WINDOW=20
# MAX_AGENT_STEPS=6
# LLM_TIMEOUT_S=25
# TURN_BUDGET_S=40
